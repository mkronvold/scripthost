{
    admin off
    auto_https off

    servers {
        trusted_proxies static private_ranges
    }
}

http://:8080 {
    @health path /healthz
    respond @health "ok" 200

    @kpe path /kpe
    respond @kpe "kpe

scripts:
  /script/install
  /script/install_wsl
  /script/install_local

curl:
  curl -fsSL 'http://HOST:8080/script/install' | sudo bash
  curl -fsSL 'http://HOST:8080/script/install_wsl' | sudo bash
  curl -fsSL 'http://HOST:8080/script/install_local' | bash

build mount:
  /srv/build

artifact examples:
  /build/usr/local/bin/k8s-login
  /build/etc/k8s-login.conf
" 200

    @install path /script/install
    handle @install {
        root * /srv/scripts
        rewrite * /install
        header Content-Type "text/plain; charset=utf-8"
        templates
        file_server
    }

    handle_path /script/* {
        root * /srv/scripts
        header Content-Type "text/plain; charset=utf-8"
        file_server
    }

    handle_path /build/* {
        root * /srv/build
        file_server
    }

    respond "scripthost" 200
}
